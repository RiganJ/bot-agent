TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
BASE_RPC_URL=https://mainnet.base.org
DATABASE_PATH=sniper.db
PAPER_START_BALANCE_IDR=100000
MAX_POSITION_IDR=20000
# Scanner reads only confirmed Base mainnet factory logs.
SCANNER_PROTOCOLS=uniswap_v3,aerodrome_v2
SCANNER_CONFIRMATIONS=12
SCANNER_BOOTSTRAP_BLOCKS=1200
# Optional explicit first block; still capped by SCANNER_MAX_BACKFILL_BLOCKS.
SCANNER_START_BLOCK=
SCANNER_MAX_BACKFILL_BLOCKS=100000
SCANNER_BLOCK_CHUNK=500
SCANNER_MIN_BLOCK_CHUNK=1
# 0=auto; Alchemy hosts are automatically capped to 10 blocks.
SCANNER_PROVIDER_MAX_BLOCK_RANGE=0
SCANNER_POLL_SECONDS=15
SCANNER_REORG_REWIND_BLOCKS=24
SCANNER_RPC_RETRIES=3
SCANNER_RPC_TIMEOUT_SECONDS=15
SCANNER_RPC_BACKOFF_SECONDS=0.5
SCANNER_RPC_REQUESTS_PER_SECOND=5
SCANNER_RPC_DAILY_REQUEST_BUDGET=100000
SCANNER_LAG_THRESHOLD_BLOCKS=30
SCANNER_BASE_BLOCK_SECONDS=2
# Optional comma-separated quote assets; defaults shown: WETH, USDC, USDbC, DAI.
SCANNER_QUOTE_ASSETS=0x4200000000000000000000000000000000000006,0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913,0xd9aAEc86B65D86f6A7B5B1b0c42FFA531710b6CA,0x50c5725949A6F0c72E6C4a641F24049A917DB0Cb
ANALYSIS_QUEUE_SIZE=100
ANALYSIS_CONCURRENCY=2
SCANNER_CIRCUIT_FAILURES=3
SCANNER_CIRCUIT_COOLDOWN_SECONDS=60
WATCH_MIN_LIQUIDITY_USD=10000
WATCH_MAX_TOKEN_AGE_HOURS=48
WATCH_MAX_RISK_SCORE=35
WATCH_MIN_EVIDENCE_CONFIDENCE=60
ALERT_MIN_INTERVAL_SECONDS=30
ALERT_MAX_PER_HOUR=20
FOCUS_REANALYZE_SECONDS=300
DEVELOPER_REFRESH_SECONDS=3600
# Optional: either Etherscan V2 key name enables Base creation and first-funder evidence.
BASESCAN_API_KEY=
ETHERSCAN_API_KEY=
# Per-host minimum request interval; provider free-tier limits still apply.
API_MIN_INTERVAL_SECONDS=0.25
